{
  "uid": "ledgerguard",
  "title": "ledgerguard \u00b7 API performance",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Response time \u00b7 p95",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "jmeter-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT mean(\"pct95.0\") FROM \"jmeter\" WHERE \"application\" = 'ledgerguard' AND \"transaction\" = 'all' AND \"statut\" = 'all' AND $timeFilter GROUP BY time(5s) fill(null)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Throughput \u00b7 requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "jmeter-influx"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT sum(\"count\") / 5 FROM \"jmeter\" WHERE \"application\" = 'ledgerguard' AND \"transaction\" = 'all' AND $timeFilter GROUP BY time(5s) fill(null)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Unexpected failures \u00b7 count",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "jmeter-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT sum(\"countError\") FROM \"jmeter\" WHERE \"application\" = 'ledgerguard' AND \"transaction\" = 'all' AND $timeFilter GROUP BY time(5s) fill(null)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Mean response time",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "jmeter-influx"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT mean(\"avg\") FROM \"jmeter\" WHERE \"application\" = 'ledgerguard' AND \"transaction\" = 'all' AND \"statut\" = 'all' AND $timeFilter GROUP BY time(5s) fill(null)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    }
  ]
}